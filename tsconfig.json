      "@personaforge/router": ["./packages/providers/router/src/index.ts"],
      "@personaforge/scheduler": ["./packages/runtime/scheduler/src/index.ts"],
      "@personaforge/sdk": ["./packages/developer/sdk/src/index.ts"],
      "@personaforge/serve": ["./packages/platform/serve/src/index.ts"],
      "@personaforge/session": ["./packages/state/session/src/index.ts"],
      "@personaforge/shared": ["./packages/foundation/shared/src/index.ts"],
      "@personaforge/storage": ["./packages/state/storage/src/index.ts"],
      "@personaforge/test-utils": ["./packages/developer/test-utils/src/index.ts"],
      "@personaforge/tools": ["./packages/tools-layer/tools/src/index.ts"],
