      "@personaforge/core": ["./packages/runtime/core/src/index.ts"],
      "@personaforge/db": ["./packages/state/db/src/index.ts"],
      "@personaforge/eval": ["./packages/platform/eval/src/index.ts"],
      "@personaforge/execution": ["./packages/runtime/execution/src/index.ts"],
      "@personaforge/graph": ["./packages/runtime/graph/src/index.ts"],
      "@personaforge/guard": ["./packages/platform/guard/src/index.ts"],
      "@personaforge/guardrails": ["./packages/platform/guardrails/src/index.ts"],
      "@personaforge/knowledge": ["./packages/state/knowledge/src/index.ts"],
      "@personaforge/learning": ["./packages/state/learning/src/index.ts"],
      "@personaforge/memory": ["./packages/state/memory/src/index.ts"],
